# Copy this file to .env and fill in real values. .env is gitignored.

# OpenRouteService API key — https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501

# MySQL database credentials — only used when DB_USE_MYSQL=true
DB_USE_MYSQL=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carbon_db
DB_USER=root
DB_PASSWORD=

# Comma-separated list of admin emails
ADMIN_EMAILS=
